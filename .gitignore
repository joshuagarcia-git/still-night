nul
*.log
*.asd

# Local testing tools (downloaded ad-hoc for diagnostic sessions)
cloudflared.exe
cloudflared

# Build output
dist/

# Local Netlify folder
.netlify

# Written by `netlify dev` when it boots the edge function runtime. Pins
# Netlify's own bootstrap URLs, not anything this project depends on.
deno.lock
